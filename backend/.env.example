# Copier en backend/.env pour le développement. En production (Railway), ces
# variables sont définies dans le service ; DATABASE_URL pointe sur l'adresse
# PRIVÉE de la base (*.railway.internal).

# ── Base de données ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/daaragest

# ── Authentification (obligatoire — le serveur refuse de démarrer sans, 32 car. min.) ──
JWT_SECRET=changez-cette-valeur-en-production-minimum-32-caracteres
# Durée du jeton d'accès (renouvelé par le refresh token de 30 j). Production : 1h
JWT_EXPIRES_IN=1h

# ── Signature des QR codes (obligatoire, 32 car. min.) ─────────────────────────
# Signe les QR des cartes élèves/personnel (HMAC SHA-256)
QR_SECRET=changez-cette-valeur-en-production-minimum-32-caracteres

# ── CORS (plusieurs origines séparées par des virgules) ────────────────────────
# Exemple : CORS_ORIGIN=https://dg.exemple.sn,https://www.dg.exemple.sn
CORS_ORIGIN=http://localhost:5173

# ── Cookies ────────────────────────────────────────────────────────────────────
# Production : domaine partagé front/API, ex. .exemple.com. Vide = cookie lié à l'hôte.
COOKIE_DOMAIN=

# ── Serveur ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Attente maximale d'une place dans la file de génération PDF avant 503 (ms, défaut 60000)
PDF_ATTENTE_MAX_MS=

# ── Installation neuve (seed-prod.cjs, base vierge) ────────────────────────────
# Mot de passe du compte admin initial. Si vide, un mot de passe aléatoire est
# généré et affiché une seule fois dans les logs. Changement imposé à la 1re connexion.
ADMIN_INITIAL_PASSWORD=
# Établissement créé à l'installation (optionnel)
ETABLISSEMENT_NOM=
ETABLISSEMENT_CODE=
ETABLISSEMENT_ADRESSE=
ETABLISSEMENT_TELEPHONE=

# ── Observabilité (optionnel — vide = Sentry désactivé) ────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
